{
    "name": "tys/tymanagement",
    "description": "TYS time and project management (Yii2 advanced)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "yiisoft/yii2": "~2.0.53",
        "yiisoft/yii2-bootstrap": "~2.0.11",
        "yiisoft/yii2-jui": "~2.0.7",
        "yiisoft/yii2-symfonymailer": "~4.0.0",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^3.0",
        "phpoffice/phpspreadsheet": "^2.3 || ^3.0 || ^4.0 || ^5.0",
        "league/csv": "^9.16",
        "illuminate/collections": "^10.0",
        "sentry/sentry": "^4.0",
        "kartik-v/yii2-grid": "^3.5",
        "2amigos/yii2-date-picker-widget": "~1.0",
        "nex/yii2-chosen": "*",
        "skinka/type-enum": "^1.0",
        "alex-bond/yii2-thumbler": "*",
        "bower-asset/autosize": "3.0.17",
        "bower-asset/bootstrap-datepicker": "1.4.0",
        "bower-asset/bootstrap-hover-dropdown": "2.2.1",
        "bower-asset/bootstrap-switch": "3.3.2",
        "bower-asset/datatables.net": "1.10.12",
        "bower-asset/datatables.net-bs": "1.10.12",
        "bower-asset/dropzone": "4.3.0",
        "bower-asset/eonasdan-bootstrap-datetimepicker": "4.17.47",
        "bower-asset/ez-plus": "1.2.1",
        "bower-asset/fancybox": "2.1.7",
        "bower-asset/fontawesome": "4.7.0",
        "bower-asset/gsap": "1.18.4",
        "bower-asset/imagesloaded": "4.1.0",
        "bower-asset/jquery-backstretch": "2.0.3",
        "bower-asset/jquery-smooth-scroll": "1.7.2",
        "bower-asset/jquery-validation": "1.14.0",
        "bower-asset/jquery.blockui": "2.70",
        "bower-asset/jquery.easing": "1.3.1",
        "bower-asset/jquery.inputmask": "3.3.8",
        "bower-asset/jquery.uniform": "2.1.2",
        "bower-asset/js-cookie": "2.1.0",
        "bower-asset/moment": "2.14.1",
        "bower-asset/select2": "4.0.4",
        "bower-asset/select2-bootstrap-theme": "0.1.0-beta.4",
        "bower-asset/simple-line-icons": "2.2.3",
        "bower-asset/slimscroll": "1.3.7",
        "bower-asset/x-editable": "1.5.1",
        "mihaildev/yii2-elfinder": "^1.4",
        "stefangabos/zebra_image": "*"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "path",
            "url": "lib/yii2-thumbler",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "lib/yii2-chosen",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "lib/zebra-image",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "asset-installer-paths": {
            "npm-asset-library": "vendor/npm",
            "bower-asset-library": "vendor/bower"
        }
    }
}